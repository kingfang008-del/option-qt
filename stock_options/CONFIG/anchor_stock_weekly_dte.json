{
  "profile": "stock_weekly_dte",
  "description": "Single-stock weekly-DTE anchor. Default excludes same-day expiry and targets the nearest Friday-style weekly expiration.",

  "front_allowed_dte": [1, 2, 3, 4, 7],
  "front_prefer_dte": 2,
  "front_min_dte": 1,
  "front_max_dte": 7,
  "exclude_0dte": true,
  "weekly_expiry_only": true,
  "use_next_buckets": false,

  "min_volume": 0,
  "atm_center": 0.50,
  "otm_center": 0.25,
  "delta_tolerance": 0.15,

  "label_trade_bucket_id": 2,
  "label_dte_min": 1,
  "label_dte_max": 7,

  "train_weekdays": [0, 1, 2, 3],
  "deploy_weekdays": [0, 1, 2, 3],
  "friday_policy": "skip_0dte",

  "symbols": ["NVDA", "TSLA"],

  "paths": {
    "raw_iv_dir": "~/train_data/stock_options_day_iv",
    "sniper_option_dir": "~/train_data/stock_option_quote_sniper",
    "day_iv_dir": "~/train_data/quote_options_day_iv_stock_weekly_dte",
    "locked_targets_output": "~/train_data/locked_targets_map_stock_weekly_dte.parquet"
  }
}

