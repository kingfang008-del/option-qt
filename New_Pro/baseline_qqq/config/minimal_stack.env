# QQQ 极简实盘栈 — F56 诚实口径（模拟实盘，禁止开卷金标）
# 用法:
#   set -a && source config/minimal_stack.env && set +a
#   或: bash ../../qqq_btc/tools/deploy_ft56_julw1_live.sh

# --- 定边：双头 call/put + q10，与 qqq_btc replay long_only=False 对齐 ---
USE_NET_EDGE_ALPHA=1
BIDIRECTIONAL_ENABLED=1
BIDIRECTIONAL_DUAL_EDGE_ENABLED=1
BIDIRECTIONAL_DISLOCATION_ENTRY_ENABLED=0

# --- 进场：V0 极简趋势腿；入场语义由 qqq_btc entry_bridge 对齐 replay ---
# put_early_vix / CALL TREND_SPENT 在 qqq_btc/qqq/config.py REPLAY 默认开启
V0_SIMPLE_ENTRY_ENABLED=1
START_MINUTE=45

# --- 执行：session 内人工选定 profile，不自动 regime 切换 ---
REGIME_ROUTING_ENABLED=0
EXEC_PROFILE=auto_hybrid

# --- 快通道门控（spread / IV）---
# qqq_btc live 下 bootstrap 默认关 FAST_GATE；spread 由 choose_entry max 6% 统一
FAST_GATE_ENABLED=0
FAST_GATE_SPREAD_MAX=0.12
FAST_GATE_IV_MOMENTUM_ABS_MAX=0.50
# 冷却与 replay cooldown_bars 对齐
COOLDOWN_MINUTES=10

# --- qqq_btc 双引擎（必须成对启动 run_live_*_qqq.py）---
QQQ_BTC_LIVE=1
QQQ_BTC_TICK_EXITS=disaster_only
ALPHA_ZSCORE_MODE=absolute
EXECUTION_DELAY_BARS=0
OMS_SIGNAL_DELAY_BARS=0
BACKTEST_OPT_FILL_SPREAD_FRAC=0.775
# 诚实实盘：因果 put_gate；关闭 regime 离线金标；Greeks 自算
QQQ_BTC_PUT_GATE_MODE=vixy_z
QQQ_BTC_REGIME_GOLD_1M=0
RECALC_GREEKS=1

# F56 / V4 特征契约（勿再用 v2）
# SLOW_FEATURE_CONFIG 由 bootstrap 默认 → qqq_btc/CONFIG/slow_feature_qqq_v4.json
# 权重默认: checkpoint/checkpoints_qqq_ft56_julw1/best.pth（见 deploy_ft56_julw1_live.sh）

# 影子对账: python ../../qqq_btc/tools/shadow_parity_report.py
# 诚实流式对拍: bash ../../qqq_btc/tools/restart_ft56_july_w1_honest_live_parity.sh
# 开卷诊断(非实盘绿灯): bash ../../qqq_btc/tools/restart_ft56_july_w1_stream_parity.sh
