# QQQ 极简实盘栈 — source 或 export 后启动 SE/OMS
# 用法: set -a && source config/minimal_stack.env && set +a

# --- 定边：双头 call/put + q10，与 qqq_btc replay long_only=False 对齐 ---
USE_NET_EDGE_ALPHA=1
BIDIRECTIONAL_ENABLED=1
BIDIRECTIONAL_DUAL_EDGE_ENABLED=1
BIDIRECTIONAL_DISLOCATION_ENTRY_ENABLED=0

# --- 进场：V0 极简趋势腿（错价腿已关）；入场语义由 qqq_btc entry_bridge 对齐 replay ---
V0_SIMPLE_ENTRY_ENABLED=1
START_MINUTE=45

# --- 执行：session 内人工选定 profile，不自动 regime 切换 ---
REGIME_ROUTING_ENABLED=0
# 震荡/常规: auto_hybrid | 短打: scalp_0dte | epic/V型: multi_band
EXEC_PROFILE=auto_hybrid

# --- 快通道门控（spread / IV）---
# qqq_btc live 下 bootstrap 默认关 FAST_GATE；spread 由 choose_entry max 6% 统一
FAST_GATE_ENABLED=0
FAST_GATE_SPREAD_MAX=0.12
FAST_GATE_IV_MOMENTUM_ABS_MAX=0.50
# 冷却与 replay cooldown_bars=5 对齐(原 60m 远严于 replay)
COOLDOWN_MINUTES=5

# --- 可选：恢复 legacy 全量门禁或实验功能 ---
# V0_SIMPLE_ENTRY_ENABLED=0
# BIDIRECTIONAL_DUAL_EDGE_ENABLED=1
# BIDIRECTIONAL_DISLOCATION_ENTRY_ENABLED=1
# BIDIRECTIONAL_ENABLED=1
# START_MINUTE=45
# REGIME_ROUTING_ENABLED=1
# EXEC_PROFILE=multi_band

# --- qqq_btc 双引擎（必须成对启动 run_live_*_qqq.py）---
QQQ_BTC_LIVE=1
QQQ_BTC_TICK_EXITS=disaster_only
ALPHA_ZSCORE_MODE=absolute
# bar 收盘后立即下单(与 strict replay entry_delay=1 解耦;标签仍按 60s 延迟)
EXECUTION_DELAY_BARS=0
OMS_SIGNAL_DELAY_BARS=0
# bootstrap 会自动设置 SLOW_FEATURE_CONFIG → qqq_btc/CONFIG/slow_feature_qqq_v2.json
# 影子对账(dry-run 一天后): python ../../qqq_btc/tools/shadow_parity_report.py
# OMS_SIGNAL_DELAY_BARS=1
# BACKTEST_OPT_FILL_SPREAD_FRAC=0.775
