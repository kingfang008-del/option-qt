{
  "comment": "qqq_btc v2:基于 New_Pro slow_feature.json 生成(make_feature_config.py),新增日内时间特征 + quantile loss。标签必须用 qqq_btc.common.labels 重建(fill 价口径,OptionSpreadFillModel frac=0.775),再跑 rolling_norm 与 LMDB。",
  "comment_keys": "键名在所有部分(labels, loss_weights)中保持一致，并与H5数据集内部路径匹配。",
  "parameters": {
    "slow_channel": {
      "window_duration_minutes": {
        "regular": 30,
        "pre_market": 5,
        "after_hours": 5
      },
      "step_duration_minutes": {
        "regular": 5,
        "pre_market": 5,
        "after_hours": 5
      },
      "label_horizon_k": 5
    },
    "labeling": {
      "method": "multi_task",
      "targets": [
        "direction",
        "volatility",
        "event"
      ],
      "volatility_k": 10,
      "event_k": 10,
      "k_option": 10,
      "resolutions": {
        "5s": {
          "horizon": 60,
          "entry_threshold": 0.0005,
          "upper_threshold": 0.0005,
          "lower_threshold": -0.0005,
          "vol_multiplier": 2.0
        },
        "10s": {
          "horizon": 45,
          "entry_threshold": 0.0007,
          "upper_threshold": 0.0007,
          "lower_threshold": -0.0007,
          "vol_multiplier": 2.0
        },
        "15s": {
          "horizon": 30,
          "entry_threshold": 0.0008,
          "upper_threshold": 0.0008,
          "lower_threshold": -0.0008,
          "vol_multiplier": 2.0
        },
        "30s": {
          "horizon": 20,
          "entry_threshold": 0.001,
          "upper_threshold": 0.001,
          "lower_threshold": -0.001,
          "vol_multiplier": 2.0
        },
        "1min": {
          "horizon": 10,
          "entry_threshold": 0.0015,
          "upper_threshold": 0.0015,
          "lower_threshold": -0.0015,
          "vol_multiplier": 2.0
        },
        "5min": {
          "horizon": 3,
          "entry_threshold": 0.0025,
          "upper_threshold": 0.0025,
          "lower_threshold": -0.0025,
          "vol_multiplier": 2.0
        }
      }
    },
    "option_exec_label": {
      "entry_delay_seconds": [
        60,
        120,
        300
      ],
      "holding_seconds": [
        180,
        300,
        900
      ],
      "primary_entry_delay_seconds": 60,
      "primary_seconds": 300,
      "min_edge": 0.02,
      "min_profit_buffer": 0.02,
      "max_spread_pct": 0.1,
      "max_quote_age_seconds": 90
    },
    "anchor_profile": "qqq_0dte",
    "anchor_config_path": "CONFIG/anchor_qqq_0dte.json",
    "training": {
      "return_huber_beta": 0.001,
      "rank_temperature": 0.002,
      "rank_min_delta": 0.0002
    },
    "pre_post_dropout_rate": 0.1,
    "expert_dropout_rate": 0.25,
    "backbone_dropout_rate": 0.3,
    "5s": {
      "sequence_length": 36,
      "hidden_dim": 32,
      "learning_rate": 0.001,
      "epochs": 20
    },
    "10s": {
      "sequence_length": 30,
      "hidden_dim": 48,
      "learning_rate": 0.0008,
      "epochs": 30
    },
    "15s": {
      "sequence_length": 30,
      "hidden_dim": 48,
      "learning_rate": 0.0007,
      "epochs": 35
    },
    "30s": {
      "sequence_length": 20,
      "hidden_dim": 48,
      "learning_rate": 0.0005,
      "epochs": 40
    },
    "1min": {
      "sequence_length": 30,
      "hidden_dim": 64,
      "learning_rate": 0.0005,
      "epochs": 50
    },
    "5min": {
      "sequence_length": 15,
      "hidden_dim": 80,
      "learning_rate": 0.0001,
      "epochs": 45
    },
    "qqq_btc_v2": {
      "fill_model": {
        "entry_frac": 0.775,
        "exit_frac": 0.775,
        "commission_per_contract": 0.65
      },
      "label_source": "qqq_btc.common.labels.build_dual_leg_net_labels",
      "time_features": [
        "time_session_sin",
        "time_session_cos",
        "time_session_progress",
        "time_to_expiry_norm"
      ],
      "trend_features": [
        "trend_fit_ret_30m",
        "trend_fit_r2_30m",
        "trend_fit_ret_120m",
        "trend_fit_r2_120m",
        "day_range_pos",
        "drawdown_from_day_high",
        "drawup_from_day_low"
      ],
      "quantiles": [
        0.1,
        0.5,
        0.9
      ],
      "embedding_caps": {
        "stock": 20000,
        "sector": 256
      }
    }
  },
  "labels": {
    "direction": {
      "type": "classification",
      "output_dim": 3
    },
    "direction_net": {
      "type": "classification",
      "output_dim": 3
    },
    "volatility": {
      "type": "regression"
    },
    "event": {
      "type": "classification",
      "output_dim": 1
    },
    "return_fwd": {
      "type": "regression"
    },
    "return_fwd_gross": {
      "type": "regression"
    },
    "return_fwd_net": {
      "type": "regression"
    },
    "execution_cost": {
      "type": "regression"
    }
  },
  "loss_weights": {
    "direction": 4.0,
    "direction_net": 4.0,
    "return_fwd": 1.0,
    "return_fwd_net": 3.0,
    "return_fwd_gross": 0.5,
    "execution_cost": 0.5,
    "rank_net": 0.0,
    "volatility": 0.1,
    "event": 0.5,
    "net_edge_quantile": 1.0,
    "call_put_edge": 0.5,
    "straddle_edge": 0.5
  },
  "resample_freq": {
    "regular": {
      "09:30-16:00": [
        "1min",
        "5min"
      ]
    }
  },
  "OHLV": [
    "open",
    "high",
    "low",
    "close",
    "volume",
    "vwap"
  ],
  "features": [
    {
      "name": "close_log_return",
      "type": "real",
      "calc": "custom",
      "resolution": "1min"
    },
    {
      "name": "vwap_log_return",
      "type": "real",
      "calc": "custom",
      "resolution": "1min"
    },
    {
      "name": "volume_log",
      "type": "real",
      "calc": "custom",
      "resolution": "1min"
    },
    {
      "name": "volume_ratio",
      "type": "real",
      "calc": "volume_ratio",
      "resolution": "1min"
    },
    {
      "name": "vwap_diff",
      "type": "real",
      "calc": "zscore",
      "alpha_sign": -1,
      "resolution": "1min"
    },
    {
      "name": "return_divergence",
      "type": "real",
      "calc": "zscore",
      "alpha_sign": -1,
      "resolution": "1min"
    },
    {
      "name": "garman_klass_vol",
      "type": "real",
      "calc": "leading",
      "use_for_anomaly": false,
      "resolution": "5min"
    },
    {
      "name": "bb_width",
      "type": "real",
      "calc": "BollingerBands(close, window=20, window_dev=2).bollinger_width()",
      "description": "Normalized Bollinger Band width",
      "resolution": "5min"
    },
    {
      "name": "adx_smooth_10",
      "type": "real",
      "calc": "adx_smooth_10",
      "resolution": "5min"
    },
    {
      "name": "vix_level",
      "type": "real",
      "calc": "vix_gate",
      "resolution": "5min"
    },
    {
      "name": "poc_deviation",
      "type": "real",
      "calc": "leading",
      "use_for_anomaly": false,
      "alpha_sign": -1,
      "resolution": "5min"
    },
    {
      "name": "options_vw_spread",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_vw_imbalance",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_vw_iv",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_vw_delta",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_vw_gamma",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_vw_vega",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_vw_theta",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_pcr_volume",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_iv_momentum",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_iv_divergence",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_gamma_accel",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_flow_skew",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "1min"
    },
    {
      "name": "options_struc_atm_iv",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "5min"
    },
    {
      "name": "options_struc_skew",
      "type": "real",
      "calc": "options",
      "use_for_anomaly": false,
      "resolution": "5min"
    },
    {
      "name": "time_session_sin",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "会话内位置 sin 编码,[-1,1],由 qqq_btc.common.time_features 补算"
    },
    {
      "name": "time_session_cos",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "会话内位置 cos 编码,[-1,1]"
    },
    {
      "name": "time_session_progress",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "会话进度 0->1 (09:30->16:00)"
    },
    {
      "name": "time_to_expiry_norm",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "0DTE 距 16:00 到期剩余时间归一化 1->0"
    },
    {
      "name": "trend_fit_ret_30m",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "过去 30 bar 对数价线性拟合总变化(拟合收益)"
    },
    {
      "name": "trend_fit_r2_30m",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "30 bar 拟合优度 R^2,[0,1],趋势规则程度"
    },
    {
      "name": "trend_fit_ret_120m",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "过去 120 bar 波段级拟合收益"
    },
    {
      "name": "trend_fit_r2_120m",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "120 bar 波段级拟合优度 R^2"
    },
    {
      "name": "day_range_pos",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "当前价在当日已实现高低区间的位置,[0,1]"
    },
    {
      "name": "drawdown_from_day_high",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "距当日已实现最高点的回撤,<=0"
    },
    {
      "name": "drawup_from_day_low",
      "type": "real",
      "calc": "raw",
      "resolution": "1min",
      "description": "距当日已实现最低点的反弹,>=0"
    }
  ]
}